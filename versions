def _read_os_release():
    """Parse /etc/os-release and return a dict of key->value strings."""
    props = {}
    try:
        with open('/etc/os-release') as f:
            for line in f:
                line = line.strip()
                if '=' not in line:
                    continue
                k, _, v = line.partition('=')
                props[k] = v.strip('"')
    except OSError:
        pass
    return props


def collect_properties():
    """Return a list of {key, value} dicts describing system properties."""
    props = []

    os_release = _read_os_release()
    name = os_release.get('NAME', '')
    version_id = os_release.get('VERSION_ID', '')
    if name and version_id:
        props.append({'key': 'os', 'value': '{} {}'.format(name, version_id)})

    cluster = os.environ.get('CLUSTER_NAME')
    if cluster:
        props.append({'key': 'cluster', 'value': cluster})

    try:
        smi = subprocess.run(
            ['nvidia-smi', '--version'],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if smi.returncode == 0:
            output = smi.stdout.decode('utf-8')
            m = re.search(r'DRIVER version\s*:\s*([\d.]+)', output, re.IGNORECASE)
            if m:
                props.append({'key': 'nvidia-driver', 'value': m.group(1)})
            m = re.search(r'CUDA Version\s*:\s*([\d.]+)', output, re.IGNORECASE)
            if m:
                props.append({'key': 'cuda', 'value': m.group(1)})
    except OSError:
        pass

    return props


def print_properties_pretty(rows):
    table = Table(
        box=box.ROUNDED,
        header_style=Style(color='bright_white', bold=True),
        border_style=Style(color='grey50'),
        show_lines=False,
        show_header=False,
    )
    table.add_column('Key',   style='bold cyan',    no_wrap=True)
    table.add_column('Value', style='bright_green', no_wrap=True)

    for row in rows:
        table.add_row(row['key'], row['value'])

    Console().print(table)


def print_properties_markdown(rows):
    print(tabulate([[r['key'], r['value']] for r in rows],
                   headers=['Key', 'Value'], tablefmt='github'))


# ---------------------------------------------------------------------------
# GCC detection
# ---------------------------------------------------------------------------

def collect_gcc_data():
    """Discover all installed gccN base packages and return a list of dicts.

    Each dict has keys:
        'major':   int, the GCC major version (e.g. 13)
        'version': Version or None
        'prefix':  str or None
        'c':       bool, base gcc compiler installed
        'cxx':     bool, gcc{N}-c++ installed
        'fortran': bool, gcc{N}-fortran installed
    """
    # Find all installed gccN base packages.
    try:
        result = subprocess.run(
            ['rpm', '-qa', '--queryformat', '%{NAME}\n'],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except OSError:
        return []

    majors = sorted({
        int(re.match(r'^gcc(\d+)$', name).group(1))
        for name in result.stdout.decode('utf-8').splitlines()
        if re.match(r'^gcc(\d+)$', name)
    })

    rows = []
    for major in majors:
        base = 'gcc{}'.format(major)
        info = query_rpm(base)
        if info and info['version']:
            # Strip build metadata suffixes like +r278197 or +git9426.
            clean = re.sub(r'\+.*$', '', str(info['version']))
            gcc_version = Version(clean)
        else:
            gcc_version = None
        prefix = info['prefix'] if info else None

        def _exe(name, rpm):
            if not _rpm_installed(rpm):
                return None
            return '{}/bin/{}-{}'.format(prefix, name, major) if prefix else None

        rows.append({
            'major':   major,
            'version': gcc_version,
            'prefix':  prefix,
            'c':       '{}/bin/gcc-{}'.format(prefix, major) if info and prefix else None,
            'cxx':     _exe('g++',      'gcc{}-c++'.format(major)),
            'fortran': _exe('gfortran', 'gcc{}-fortran'.format(major)),
        })
    return rows


def _lang_cell(exe, fmt):
    if fmt == 'pretty':
        return '[bright_green]{}[/bright_green]'.format(exe) if exe else '[dim]✘[/dim]'
    return exe if exe else '-'


def print_gcc_pretty(rows):
    table = Table(
        box=box.ROUNDED,
        header_style=Style(color='bright_white', bold=True),
        border_style=Style(color='grey50'),
        show_lines=False,
    )
    table.add_column('GCC',     style='bold cyan',      no_wrap=True)
    table.add_column('Version', style='bright_green',   no_wrap=True)
    table.add_column('C',       justify='center',       no_wrap=True)
    table.add_column('C++',     justify='center',       no_wrap=True)
    table.add_column('Fortran', justify='center',       no_wrap=True)
    table.add_column('Prefix',  style='bright_magenta', no_wrap=True)

    for row in rows:
        table.add_row(
            str(row['major']),
            str(row['version']) if row['version'] else '[dim]-[/dim]',
            _lang_cell(row['c'],       'pretty'),
            _lang_cell(row['cxx'],     'pretty'),
            _lang_cell(row['fortran'], 'pretty'),
            row['prefix'] or '[dim]-[/dim]',
        )

    Console().print(table)


def print_gcc_markdown(rows):
    table = [
        [
            row['major'],
            _lang_cell(row['c'],       'md'),
            _lang_cell(row['cxx'],     'md'),
            _lang_cell(row['fortran'], 'md'),
            row['prefix'] or '-',
        ]
        for row in rows
    ]
    headers = ['GCC', 'C', 'C++', 'Fortran', 'Prefix']
    print(tabulate(table, headers=headers, tablefmt='github'))


def _gcc_rows_to_json(rows):
    return [
        {
            'major':   row['major'],
            'version': str(row['version']) if row['version'] else None,
            'prefix':  row['prefix'],
            'c':       row['c'],
            'cxx':     row['cxx'],
            'fortran': row['fortran'],
        }
        for row in rows
    ]


def print_gcc_json(rows):
    print(json.dumps(_gcc_rows_to_json(rows), indent=2))


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='Report installed Cray package versions.')
    parser.add_argument(
        '--format',
        choices=['pretty', 'markdown', 'json'],
        default='pretty',
        help='Output format (default: pretty)',
    )
    args = parser.parse_args()

    prop_rows = collect_properties()
    rows      = collect_data()
    gcc_rows  = collect_gcc_data()

    if args.format == 'pretty':
        print_properties_pretty(prop_rows)
        print_pretty(rows)
        print_gcc_pretty(gcc_rows)
    elif args.format == 'markdown':
        print_properties_markdown(prop_rows)
        print()
        print_markdown(rows)
        print()
        print_gcc_markdown(gcc_rows)
    elif args.format == 'json':
        print(json.dumps({
            'properties': prop_rows,
            'packages':   _rows_to_json(rows),
            'gcc':        _gcc_rows_to_json(gcc_rows),
        }, indent=2))

